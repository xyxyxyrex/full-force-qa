# Supabase account and review-sharing public configuration (independent of Monday)
# Build-time values are embedded in the desktop main process. Never put a service-role key here.
# Google OAuth credentials stay in Supabase Auth and are never stored in the desktop app.
# Supabase Cloud Configuration
VITE_SUPABASE_URL=https://hjrfvjvirdzdevzmcalp.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Monday OAuth credentials are stored in the Supabase monday-oauth function,
# not in the desktop .env. Local development uses the Supabase values above.

# Cloudflare Pages Ephemeral Viewer URL
VITE_EPHEMERAL_VIEWER_URL=https://parity-gfx.pages.dev
