{
  "name": "qa-snapshot-editor",
  "version": "0.1.0",
  "description": "QA Snapshot Editor - Freeze and visually edit WordPress staging pages",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-dev.js electron-vite dev",
    "build": "node scripts/electron-dev.js electron-vite build",
    "preview": "node scripts/electron-dev.js electron-vite preview",
    "build:dist": "node scripts/electron-dev.js electron-vite build && node scripts/electron-dev.js electron-builder"
  },
  "dependencies": {
    "grapesjs": "^0.23.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.qa-snapshot-editor",
    "productName": "QA Snapshot Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ]
  }
}