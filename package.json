{
  "name": "parity",
  "version": "1.5.5",
  "description": "Parity - Capture, compare, annotate, and share implementation reviews",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dev": "node scripts/electron-dev.js electron-vite dev",
    "build": "node scripts/electron-dev.js electron-vite build",
    "build:viewer": "node scripts/build-viewer.js",
    "dev:viewer": "npm run build:viewer && wrangler pages dev",
    "deploy:viewer": "npm run build:viewer && wrangler pages deploy dist-viewer --project-name parity-gfx",
    "preview": "node scripts/electron-dev.js electron-vite preview",
    "parity": "node resources/cli/parity.cjs",
    "test": "vitest run",
    "test:accounts:database": "node scripts/test-account-database.cjs",
    "test:accounts:electron": "node scripts/test-account-electron.cjs",
    "test:feedback:electron": "node scripts/test-feedback-electron.cjs",
    "test:feedback:edge": "node scripts/test-feedback-edge.cjs",
    "test:inspector:electron": "node scripts/test-inspector-electron.cjs",
    "test:free-transform:electron": "node scripts/test-free-transform-electron.cjs",
    "test:audit-media:electron": "node scripts/test-audit-media-electron.cjs",
    "test:audit-inspector:electron": "node scripts/test-audit-inspector-electron.cjs",
    "test:dashboard-menu:electron": "node scripts/test-dashboard-context-menu-electron.cjs",
    "test:comparison:electron": "node scripts/test-comparison-electron.cjs",
    "test:comparison:ui": "node scripts/test-comparison-ui-electron.cjs",
    "test:figma:ui": "node scripts/test-figma-comparison-ui-electron.cjs",
    "test:palette:electron": "node scripts/test-palette-electron.cjs",
    "test:automation:electron": "node scripts/test-automation-electron.cjs",
    "test:qa-capture:electron": "node scripts/test-qa-capture-electron.cjs",
    "test:qa-flow:electron": "node scripts/test-qa-flow-electron.cjs",
    "test:qa-ui:electron": "node scripts/test-qa-ui-electron.cjs",
    "test:qa-window:electron": "node scripts/test-qa-window-electron.cjs",
    "test:viewer:electron": "node scripts/test-viewer-evidence-electron.cjs",
    "test:qa-browser:electron": "node scripts/test-qa-browser-electron.cjs",
    "test:page-checks:electron": "node scripts/test-page-checks-electron.cjs",
    "test:site-auth:electron": "node scripts/test-site-auth-electron.cjs --native",
    "test:watch": "vitest",
    "build:visual-worker": "python -m PyInstaller --noconfirm --clean --onefile --name visual-compare --distpath resources/visual-worker --workpath .python-build --specpath .python-build python/visual_compare.py",
    "build:dist": "npm run build:visual-worker && node scripts/electron-dev.js electron-vite build && node scripts/electron-dev.js electron-builder --publish never",
    "release:win": "npm run build:visual-worker && node scripts/electron-dev.js electron-vite build && node scripts/electron-dev.js electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@supabase/supabase-js": "^2.112.2",
    "dictionary-en": "^4.0.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "grapesjs": "^0.23.3",
    "harper.js": "^2.7.0",
    "nspell": "^2.1.5",
    "pixelmatch": "^7.2.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@swc/core": "^1.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.fullforce.parity",
    "productName": "Parity",
    "artifactName": "Parity-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/automation-smoke-*/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/visual-worker",
        "to": "visual-worker",
        "filter": [
          "visual-compare*"
        ]
      },
      {
        "from": "resources/cli",
        "to": "cli",
        "filter": [
          "parity.cjs"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "guid": "5ef26538-4975-5aa9-a3b5-3c7d87c3904e",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Parity",
      "uninstallDisplayName": "Parity"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xyxyxyrex",
        "repo": "full-force-qa",
        "releaseType": "release"
      }
    ]
  }
}
