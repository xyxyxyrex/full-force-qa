{
  "name": "parity",
  "version": "1.3.5",
  "description": "Parity - Capture, compare, annotate, and share implementation reviews",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-dev.js electron-vite dev",
    "build": "node scripts/electron-dev.js electron-vite build",
    "build:viewer": "node scripts/build-viewer.js",
    "dev:viewer": "npm run build:viewer && wrangler pages dev",
    "deploy:viewer": "npm run build:viewer && wrangler pages deploy dist-viewer --project-name parity-gfx",
    "preview": "node scripts/electron-dev.js electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:visual-worker": "python -m PyInstaller --noconfirm --clean --onefile --name visual-compare --distpath resources/visual-worker --workpath .python-build --specpath .python-build python/visual_compare.py",
    "build:dist": "npm run build:visual-worker && node scripts/electron-dev.js electron-vite build && node scripts/electron-dev.js electron-builder --publish never",
    "release:win": "npm run build:visual-worker && node scripts/electron-dev.js electron-vite build && node scripts/electron-dev.js electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@supabase/supabase-js": "^2.112.2",
    "dictionary-en": "^4.0.0",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "grapesjs": "^0.23.3",
    "harper.js": "^2.7.0",
    "nspell": "^2.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@swc/core": "^1.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "build": {
    "appId": "com.fullforce.parity",
    "productName": "Parity",
    "artifactName": "Parity-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/visual-worker",
        "to": "visual-worker",
        "filter": [
          "visual-compare*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "guid": "5ef26538-4975-5aa9-a3b5-3c7d87c3904e",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Parity",
      "uninstallDisplayName": "Parity"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xyxyxyrex",
        "repo": "full-force-qa",
        "releaseType": "release"
      }
    ]
  }
}
