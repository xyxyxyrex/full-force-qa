{
  "name": "qa-snapshot-editor",
  "version": "1.0.0",
  "description": "QA Snapshot Editor - Freeze and visually edit WordPress staging pages",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-dev.js electron-vite dev",
    "build": "node scripts/electron-dev.js electron-vite build",
    "build:viewer": "node scripts/build-viewer.js",
    "dev:viewer": "npm run build:viewer && wrangler pages dev",
    "deploy:viewer": "npm run build:viewer && wrangler pages deploy dist-viewer --project-name qa-snapshots",
    "preview": "node scripts/electron-dev.js electron-vite preview",
    "build:visual-worker": "python -m PyInstaller --noconfirm --clean --onefile --name visual-compare --distpath resources/visual-worker --workpath .python-build --specpath .python-build python/visual_compare.py",
    "build:dist": "npm run build:visual-worker && node scripts/electron-dev.js electron-vite build && node scripts/electron-dev.js electron-builder"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@supabase/supabase-js": "^2.112.2",
    "dictionary-en": "^4.0.0",
    "grapesjs": "^0.23.3",
    "harper.js": "^2.7.0",
    "nspell": "^2.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@swc/core": "^1.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.120.0"
  },
  "build": {
    "appId": "com.qa-snapshot-editor",
    "productName": "QA Snapshot Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/visual-worker",
        "to": "visual-worker",
        "filter": [
          "visual-compare*"
        ]
      }
    ]
  }
}
